[Unit]
Description=EasyOCR Server for RobotPDF
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/robotpdf/backend/python_services
Environment=PYTHONUNBUFFERED=1
Environment=OCR_SERVER_PORT=5050
ExecStart=/home/ubuntu/robotpdf-env/bin/python3 /home/ubuntu/robotpdf/backend/python_services/ocr_server.py
Restart=always
RestartSec=10

# Resource limits for t4g.medium (4GB RAM)
MemoryMax=2G
CPUQuota=150%

[Install]
WantedBy=multi-user.target
